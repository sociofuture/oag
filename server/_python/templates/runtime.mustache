def verify(abc: type, impl: type) -> None:
    """起動時に、実装が ABC を継承し抽象メソッドをすべて実装していることを確認する。"""
    if not issubclass(impl, abc):
        raise TypeError(f"{impl.__module__}.{impl.__name__} は {abc.__name__} を継承してください")
    if inspect.isabstract(impl):
        missing = ", ".join(sorted(getattr(impl, "__abstractmethods__", ())))
        raise TypeError(f"{impl.__module__}.{impl.__name__} に未実装のメソッドがあります: {missing}")
